<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RaytolfasLauncher.AddAccountDialog"
        Title="Добавить аккаунт"
        Width="380" Height="210"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        CanResize="False">

    <Border Background="#121212" BorderBrush="#1A1A1A" BorderThickness="1" CornerRadius="16">
        <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,Auto">
            <TextBlock x:Name="TitleText" Grid.Row="0" Text="ДОБАВИТЬ ОФФЛАЙН АККАУНТ" Foreground="#BB86FC" FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>

            <TextBlock x:Name="PromptText" Grid.Row="1" Text="Введите никнейм:" Foreground="Gray" FontSize="11" Margin="0,0,0,6"/>

            <TextBox x:Name="UsernameBox" Grid.Row="2" Background="#2D2D2D" Foreground="White" BorderThickness="0" CornerRadius="8" Padding="10,8" Margin="0,0,0,16"/>

            <Grid Grid.Row="3" ColumnDefinitions="*,*">
                <Button x:Name="CancelButton" Grid.Column="0" Content="ОТМЕНА" Click="Cancel_Click" Height="36" Margin="0,0,6,0" Background="#2D2D2D" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" CornerRadius="8"/>
                <Button x:Name="ConfirmButton" Grid.Column="1" Content="ДОБАВИТЬ" Click="Confirm_Click" Height="36" Margin="6,0,0,0" Background="#BB86FC" Foreground="Black" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" CornerRadius="8"/>
            </Grid>
        </Grid>
    </Border>
</Window>
