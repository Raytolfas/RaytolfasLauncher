<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RaytolfasLauncher"
        x:Class="RaytolfasLauncher.LogWindow"
        Title="Логи запуска"
        Height="500"
        Width="780"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        PointerPressed="Window_PointerPressed"
        CanResize="True">

    <Border BorderBrush="#202430" BorderThickness="1" CornerRadius="16" Background="#101217" Padding="16">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,0,0,8">
                <TextBlock x:Name="LogTitleText" Text="ЛОГИ ЗАПУСКА" Foreground="White" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                <Border Grid.Column="1"
                        x:Name="BetaBadgeBorder"
                        Background="#2B1A40"
                        CornerRadius="6"
                        Margin="10,0,0,0"
                        Padding="8,2"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="BetaBadgeText" Text="LOGS" Foreground="#A250FF" FontWeight="Bold" FontSize="10"/>
                </Border>
                <Button Grid.Column="3" Click="Close_Click" Width="28" Height="28" CornerRadius="6" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <PathIcon Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" Width="12" Height="12" Foreground="#8E9297"/>
                </Button>
            </Grid>

            <TextBlock x:Name="LogDescriptionText"
                       Grid.Row="1"
                       Text="Отображение логов Minecraft и клиента в реальном времени"
                       Foreground="#8E9297"
                       FontSize="11"
                       Margin="0,0,0,10"/>

                        <Border Grid.Row="2" Background="#0C0D11" BorderBrush="#1C1F28" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                <ListBox x:Name="LogListBox"
                         Background="Transparent"
                         BorderThickness="0"
                         FontFamily="Consolas, monospace"
                         FontSize="12"
                         Padding="10">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="2,1"/>
                            <Setter Property="MinHeight" Value="18"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="local:LogWindow+LogEntry">
                            <WrapPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding PrefixText}" Foreground="#60646C" Margin="0,0,6,0"/>
                                <SelectableTextBlock Text="{Binding Message}" Foreground="{Binding Brush}" TextWrapping="Wrap"/>
                            </WrapPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

                        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" Margin="0,10,0,0">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ClearButton" Content="Очистить" Click="Clear_Click" Height="30" Padding="12,0" Background="#1E2028" Foreground="White" FontSize="11" CornerRadius="6" Cursor="Hand" BorderThickness="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    <Button x:Name="CopyButton" Content="Копировать" Click="Copy_Click" Height="30" Padding="12,0" Background="#1E2028" Foreground="White" FontSize="11" CornerRadius="6" Cursor="Hand" BorderThickness="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                </StackPanel>

                <Button x:Name="HideButton" Grid.Column="2" Content="Закрыть" Click="Close_Click" Height="30" Padding="16,0" Background="#A250FF" Foreground="White" FontWeight="Bold" FontSize="11" CornerRadius="6" Cursor="Hand" BorderThickness="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>
