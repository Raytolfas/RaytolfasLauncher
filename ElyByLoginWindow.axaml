<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RaytolfasLauncher.ElyByLoginWindow"
        Title="Ely.by"
        Height="340"
        Width="420"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        CanResize="False">

    <Border BorderBrush="#1A1A1A" BorderThickness="1" CornerRadius="20" Background="#121212">
        <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
            <TextBlock x:Name="TitleText"
                       Text="ELY.BY"
                       Foreground="#BB86FC"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,16"/>

            <TextBlock x:Name="LoginLabel" Grid.Row="1" Text="ЛОГИН ИЛИ E-MAIL" Foreground="Gray" FontSize="10" Margin="0,0,0,6"/>
            <TextBox x:Name="LoginBox" Grid.Row="2" Background="#2D2D2D" Foreground="White" BorderThickness="0" CornerRadius="8" Padding="10"/>

            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                <TextBlock x:Name="PasswordLabel" Text="ПАРОЛЬ" Foreground="Gray" FontSize="10" Margin="0,0,0,6"/>
                <TextBox x:Name="PasswordBox" PasswordChar="•" Background="#2D2D2D" Foreground="White" BorderThickness="0" CornerRadius="8" Padding="10"/>
                <TextBlock x:Name="TotpLabel" Text="2FA TOKEN (НЕОБЯЗАТЕЛЬНО)" Foreground="Gray" FontSize="10" Margin="0,12,0,6"/>
                <TextBox x:Name="TotpBox" Background="#2D2D2D" Foreground="White" BorderThickness="0" CornerRadius="8" Padding="10"/>
            </StackPanel>

            <TextBlock x:Name="HintText"
                       Grid.Row="4"
                       Text="Если у тебя включена двухфакторная защита, введи код в поле 2FA."
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="0,14,0,0"/>

            <Grid Grid.Row="5" Margin="0,18,0,0" ColumnDefinitions="*,*">
                <Button x:Name="CancelButton" Grid.Column="0" Content="ОТМЕНА" Click="Cancel_Click" Height="42" Margin="0,0,6,0" Background="#2D2D2D" Foreground="White" BorderThickness="0" CornerRadius="10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                <Button x:Name="LoginButton" Grid.Column="1" Content="ВОЙТИ" Click="Login_Click" Height="42" Margin="6,0,0,0" Background="#BB86FC" Foreground="Black" FontWeight="Bold" BorderThickness="0" CornerRadius="10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>
