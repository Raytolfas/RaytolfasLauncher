<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RaytolfasLauncher.UpdateWindow"
        Title="Обновление лаунчера"
        Height="310"
        Width="460"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        PointerPressed="Window_PointerPressed"
        CanResize="False">

    <Border BorderBrush="#202430" BorderThickness="1" CornerRadius="18" Background="#101217" Padding="20">
        <Grid RowDefinitions="Auto,*,Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                <TextBlock x:Name="UpdateTitleText" Text="ДОСТУПНО ОБНОВЛЕНИЕ" Foreground="#A250FF" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button x:Name="CloseButton" Grid.Column="1" Click="CloseUpdate_Click" Width="28" Height="28" CornerRadius="6" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <PathIcon Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" Width="12" Height="12" Foreground="#8E9297"/>
                </Button>
            </Grid>

                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="10">
                <Border Background="#161822" BorderBrush="#252A38" BorderThickness="1" CornerRadius="10" Padding="12,8" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="CurrentVersionLabel" Text="Текущая: " Foreground="#8E9297" FontSize="12"/>
                        <TextBlock x:Name="CurrentVerText" Text="0.1.0" Foreground="White" FontWeight="Bold" FontSize="12"/>
                        <TextBlock Text="→" Foreground="#8E9297" FontSize="12" Margin="4,0"/>
                        <TextBlock x:Name="NewVersionLabel" Text="Новая: " Foreground="#8E9297" FontSize="12"/>
                        <TextBlock x:Name="NewVerText" Text="0.1.0" Foreground="#A250FF" FontWeight="Bold" FontSize="12"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="ChangelogText" Text="Загрузка списка изменений..." Foreground="#A0A4B0" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4"/>

                <ProgressBar x:Name="UpdateProgress" Height="8" CornerRadius="4" Margin="10,6" IsVisible="False" Foreground="#A250FF" Background="#202430"/>
            </StackPanel>

                        <Grid Grid.Row="2" ColumnDefinitions="*,*" Margin="0,10,0,0">
                <Button x:Name="CancelBtn" Grid.Column="0" Content="ОТМЕНА" Click="CancelBtn_Click" Height="38" Margin="0,0,6,0" Background="#1E2028" Foreground="White" FontSize="11" FontWeight="SemiBold" CornerRadius="8" Cursor="Hand" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                <Button x:Name="DownloadBtn" Grid.Column="1" Content="ОБНОВИТЬ" Click="DownloadBtn_Click" Height="38" Margin="6,0,0,0" Background="#A250FF" Foreground="White" FontSize="11" FontWeight="Bold" CornerRadius="8" Cursor="Hand" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                <Button x:Name="RestartBtn" Grid.Column="1" Content="ПЕРЕЗАПУСТИТЬ" Click="RestartBtn_Click" IsVisible="False" Height="38" Margin="6,0,0,0" Background="#00C853" Foreground="White" FontSize="11" FontWeight="Bold" CornerRadius="8" Cursor="Hand" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>
