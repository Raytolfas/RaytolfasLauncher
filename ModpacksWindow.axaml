<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RaytolfasLauncher"
        x:Class="RaytolfasLauncher.ModpacksWindow"
        Title="Управление сборками"
        Height="620"
        Width="940"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        CanResize="False"
        PointerPressed="Window_PointerPressed">

    <Border BorderBrush="#20222A" BorderThickness="1" CornerRadius="16" Background="#111215" ClipToBounds="True">
        <Panel>
            <Grid RowDefinitions="Auto,*" Margin="24,18,24,20">
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderTitleText" Text="СБОРКИ" Foreground="White" FontSize="18" FontWeight="Bold"/>
                        <TextBlock x:Name="HeaderSubtitleText" Text="" IsVisible="False"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="✕" Click="Close_Click" Background="Transparent" Foreground="#8E9297" BorderThickness="0" Width="36" Height="36" FontSize="16" Cursor="Hand" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                </Grid>

                                <Grid Grid.Row="1" ColumnDefinitions="280,18,*">
                                        <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto">
                        <TextBlock x:Name="YourPacksLabel" Grid.Row="0" Text="ПРОФИЛИ" Foreground="#8E9297" FontSize="11" FontWeight="Bold" Margin="4,0,0,8"/>

                        <ListBox x:Name="ModpacksListBox" Grid.Row="1" Background="#16181F" BorderThickness="0" CornerRadius="10" SelectionChanged="ModpacksListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="local:ModpackInfo">
                                    <Border Padding="10,8" CornerRadius="8" Background="Transparent">
                                        <Grid ColumnDefinitions="32,*">
                                            <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6" Background="#23272F" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Viewbox Width="14" Height="14">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Stroke="White" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                                                              Data="M2.3084 7.0066L12 12M12 12L21.6916 7.0066M12 12L12 22M7 4.3017L17 9.4239M12.9075 2.2178L20.9075 6.2914C21.5779 6.6328 22 7.3214 22 8.0737L22 15.9263C22 16.6786 21.5779 17.3672 20.9075 17.7086L12.9075 21.7822C12.3373 22.0726 11.6627 22.0726 11.0925 21.7822L3.0925 17.7086C2.4221 17.3672 2 16.6786 2 15.9263L2 8.0737C2 7.3214 2.4221 6.6328 3.0925 6.2914L11.0925 2.2178C11.6627 1.9274 12.3373 1.9274 12.9075 2.2178Z"/>
                                                    </Canvas>
                                                </Viewbox>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" Foreground="White" FontWeight="Bold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Subtitle}" Foreground="#8E9297" FontSize="10" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                                                <StackPanel Grid.Row="2" Margin="0,12,0,0" Spacing="6">
                            <Button x:Name="CreatePackButton" Click="OpenCreateModal_Click" Height="36" HorizontalAlignment="Stretch" Background="#A250FF" CornerRadius="8" Cursor="Hand" BorderThickness="0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                    <Viewbox Width="15" Height="15">
                                        <Canvas Width="24" Height="24">
                                            <Path Stroke="White" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                                                  Data="M12 2C17.5228 2 22 6.47715 22 12C22 17.5228 17.5228 22 12 22C6.47715 22 2 17.5228 2 12C2 6.47715 6.47715 2 12 2ZM8 12H16M11.995 16.005V8.005"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock x:Name="CreatePackText" Text="Создать сборку" Foreground="White" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Grid ColumnDefinitions="*,*">
                                <Button x:Name="ImportMrPackButton" Grid.Column="0" Content=".MRPACK" Click="ImportMrPack_Click" Height="30" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#1E2028" Foreground="White" FontSize="11" FontWeight="SemiBold" CornerRadius="6" Cursor="Hand" BorderThickness="0" Margin="0,0,3,0"/>
                                <Button x:Name="DeletePackButton" Grid.Column="1" Click="DeleteModpack_Click" Height="30" HorizontalAlignment="Stretch" Background="#261A22" CornerRadius="6" Cursor="Hand" BorderThickness="0" Margin="3,0,0,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                                        <Viewbox Width="13" Height="13">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="#FF6B6B"
                                                      Data="M20 6C20.5523 6 21 6.4477 21 7C21 7.5523 20.5523 8 20 8L19 8L19 19C19 21.2091 17.2091 23 15 23L9 23C6.7909 23 5 21.2091 5 19L5 8L4 8C3.4477 8 3 7.5523 3 7C3 6.4477 3.4477 6 4 6L20 6ZM14 1C14.5523 1 15 1.4477 15 2C15 2.5523 14.5523 3 14 3L10 3C9.4477 3 9 2.5523 9 2C9 1.4477 9.4477 1 10 1L14 1ZM11 11C11 10.4477 10.5523 10 10 10C9.4477 10 9 10.4477 9 11L9 18C9 18.5523 9.4477 19 10 19C10.5523 19 11 18.5523 11 18L11 11ZM15 11C15 10.4477 14.5523 10 14 10C13.4477 10 13 10.4477 13 11L13 18C13 18.5523 13.4477 19 14 19C14.5523 19 15 18.5523 15 18L15 11Z"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock x:Name="DeletePackText" Text="Удалить" Foreground="#FF6B6B" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>

                                        <Grid Grid.Column="2">
                                                <Border x:Name="NoSelectionPanel" Background="#16181F" CornerRadius="12" Padding="24" IsVisible="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                                <Viewbox Width="36" Height="36" HorizontalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="#4E5362" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                                              Data="M2.3084 7.0066L12 12M12 12L21.6916 7.0066M12 12L12 22M7 4.3017L17 9.4239M12.9075 2.2178L20.9075 6.2914C21.5779 6.6328 22 7.3214 22 8.0737L22 15.9263C22 16.6786 21.5779 17.3672 20.9075 17.7086L12.9075 21.7822C12.3373 22.0726 11.6627 22.0726 11.0925 21.7822L3.0925 17.7086C2.4221 17.3672 2 16.6786 2 15.9263L2 8.0737C2 7.3214 2.4221 6.6328 3.0925 6.2914L11.0925 2.2178C11.6627 1.9274 12.3373 1.9274 12.9075 2.2178Z"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock x:Name="NoSelectionTitle" Text="Выберите сборку слева или создайте новую" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="NoSelectionSubtitle" Text="Каждая сборка изолирована и содержит свои моды, ресурс-паки и шейдеры" Foreground="#8E9297" FontSize="11" HorizontalAlignment="Center"/>
                                <Button x:Name="NoSelectionCreateButton" Content="+ Создать сборку" Click="OpenCreateModal_Click" Height="36" Padding="20,0" HorizontalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#A250FF" Foreground="White" FontWeight="Bold" FontSize="11" CornerRadius="8" Cursor="Hand" BorderThickness="0" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                                                <Grid x:Name="PackDetailsPanel" RowDefinitions="Auto,Auto,*,Auto" IsVisible="False">
                                                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                                    <TextBlock x:Name="SelectedPackTitle" Text="Моя сборка" Foreground="White" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                                    <Border x:Name="SelectedPackBadge" Background="#261A3D" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                        <TextBlock x:Name="SelectedPackBadgeText" Text="Fabric 1.20.1" Foreground="#A250FF" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                        <Button x:Name="OpenPackFolderBtn" Content="Папка" Height="32" Padding="12,0" Background="#1E2028" Foreground="White" FontSize="11" CornerRadius="6" Cursor="Hand" BorderThickness="0" VerticalContentAlignment="Center">
                                        <Button.Flyout>
                                            <MenuFlyout Placement="Bottom">
                                                <MenuItem Header="Папка сборки" Click="OpenPackFolder_Click"/>
                                                <MenuItem Header="Моды (mods)" Click="OpenModsFolder_Click"/>
                                                <MenuItem Header="Ресурс-паки (resourcepacks)" Click="OpenResourcepacksFolder_Click"/>
                                                <MenuItem Header="Шейдеры (shaderpacks)" Click="OpenShaderpacksFolder_Click"/>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>

                                                                        <Button x:Name="SelectForPlayBtn" Content="Выбрать для игры" Click="SelectForPlay_Click" Height="32" Padding="16,0" Background="#A250FF" Foreground="White" FontWeight="Bold" FontSize="11" CornerRadius="6" Cursor="Hand" BorderThickness="0" VerticalContentAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                                                        <Border Grid.Row="1" Background="#161822" BorderBrush="#252A38" BorderThickness="1" CornerRadius="8" Padding="3" HorizontalAlignment="Left" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Button x:Name="TabInstalledBtn" Content="Установленные" Click="ShowInstalledTab_Click" Height="30" Padding="14,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#A250FF" Foreground="White" FontWeight="Bold" FontSize="11" CornerRadius="6" Cursor="Hand" BorderThickness="0"/>
                                    <Button x:Name="TabModrinthBtn" Content="Каталог Modrinth" Click="ShowModrinthTab_Click" Height="30" Padding="14,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="Transparent" Foreground="#8E9297" FontWeight="Bold" FontSize="11" CornerRadius="6" Cursor="Hand" BorderThickness="0"/>
                                </StackPanel>
                            </Border>

                                                        <Grid x:Name="InstalledTabPanel" Grid.Row="2" RowDefinitions="Auto,*" IsVisible="True">
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="0,0,0,12">
                                    <Button x:Name="FilterAllBtn" Content="Все" Click="FilterInstalled_Click" Tag="all" Height="26" Padding="12,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#A250FF" Foreground="White" FontSize="10" FontWeight="Bold" CornerRadius="6" Cursor="Hand" BorderThickness="0"/>
                                    <Button x:Name="FilterModsBtn" Content="Моды" Click="FilterInstalled_Click" Tag="mods" Height="26" Padding="12,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#1E2028" Foreground="White" FontSize="10" CornerRadius="6" Cursor="Hand" BorderThickness="0"/>
                                    <Button x:Name="FilterPacksBtn" Content="Ресурс-паки" Click="FilterInstalled_Click" Tag="resourcepacks" Height="26" Padding="12,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#1E2028" Foreground="White" FontSize="10" CornerRadius="6" Cursor="Hand" BorderThickness="0"/>
                                    <Button x:Name="FilterShadersBtn" Content="Шейдеры" Click="FilterInstalled_Click" Tag="shaderpacks" Height="26" Padding="12,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#1E2028" Foreground="White" FontSize="10" CornerRadius="6" Cursor="Hand" BorderThickness="0"/>
                                </StackPanel>

                                <ListBox x:Name="InstalledFilesListBox" Grid.Row="1" Background="#16181F" BorderThickness="0" CornerRadius="10">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="local:ModpackFileItem">
                                            <Grid ColumnDefinitions="*,Auto,Auto" Margin="4,2">
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FileName}" Foreground="White" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Category}" Foreground="#8E9297" FontSize="10"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding FileSizeFormatted}" Foreground="#8E9297" FontSize="11" VerticalAlignment="Center" Margin="10,0,10,0"/>
                                                <Button Grid.Column="2" Click="DeleteFile_Click" Tag="{Binding FullPath}" Background="Transparent" BorderThickness="0" Cursor="Hand" Width="28" Height="28" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Удалить файл">
                                                    <Viewbox Width="13" Height="13">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Fill="#FF6B6B"
                                                                  Data="M20 6C20.5523 6 21 6.4477 21 7C21 7.5523 20.5523 8 20 8L19 8L19 19C19 21.2091 17.2091 23 15 23L9 23C6.7909 23 5 21.2091 5 19L5 8L4 8C3.4477 8 3 7.5523 3 7C3 6.4477 3.4477 6 4 6L20 6ZM14 1C14.5523 1 15 1.4477 15 2C15 2.5523 14.5523 3 14 3L10 3C9.4477 3 9 2.5523 9 2C9 1.4477 9.4477 1 10 1L14 1ZM11 11C11 10.4477 10.5523 10 10 10C9.4477 10 9 10.4477 9 11L9 18C9 18.5523 9.4477 19 10 19C10.5523 19 11 18.5523 11 18L11 11ZM15 11C15 10.4477 14.5523 10 14 10C13.4477 10 13 10.4477 13 11L13 18C13 18.5523 13.4477 19 14 19C14.5523 19 15 18.5523 15 18L15 11Z"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>

                                                        <Grid x:Name="ModrinthTabPanel" Grid.Row="3" RowDefinitions="Auto,*" IsVisible="False">
                                                                <Grid Grid.Row="0" ColumnDefinitions="*,130,90" Margin="0,0,0,8">
                                    <TextBox x:Name="ModrinthSearchBox" Grid.Column="0" Watermark="Поиск модов на Modrinth..." Height="32" Background="#1E2028" Foreground="White" BorderBrush="#2A2E39" CornerRadius="6" Margin="0,0,6,0" KeyDown="ModrinthSearchBox_KeyDown"/>
                                    <ComboBox x:Name="ModrinthTypeBox" Grid.Column="1" Height="32" Classes="RayCombo" HorizontalAlignment="Stretch" Margin="0,0,6,0" SelectionChanged="ModrinthTypeBox_SelectionChanged"/>
                                    <Button x:Name="SearchModrinthButton" Grid.Column="2" Content="Найти" Click="SearchModrinth_Click" Height="32" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#A250FF" Foreground="White" FontWeight="Bold" FontSize="11" CornerRadius="6" Cursor="Hand" BorderThickness="0"/>
                                </Grid>

                                                                <ListBox x:Name="ModrinthResultsListBox" Grid.Row="1" Background="#16181F" BorderThickness="0" CornerRadius="10">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="local:ModrinthProjectHit">
                                            <Border Padding="10,8" Margin="0,0,0,6" Background="#1E2028" CornerRadius="8">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                                                                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" Background="#262933" Margin="0,0,12,0" ClipToBounds="True" VerticalAlignment="Center">
                                                        <Panel>
                                                            <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Canvas Width="24" Height="24">
                                                                    <Path Stroke="#60646C" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                                                                          Data="M2.3084 7.0066L12 12M12 12L21.6916 7.0066M12 12L12 22M7 4.3017L17 9.4239M12.9075 2.2178L20.9075 6.2914C21.5779 6.6328 22 7.3214 22 8.0737L22 15.9263C22 16.6786 21.5779 17.3672 20.9075 17.7086L12.9075 21.7822C12.3373 22.0726 11.6627 22.0726 11.0925 21.7822L3.0925 17.7086C2.4221 17.3672 2 16.6786 2 15.9263L2 8.0737C2 7.3214 2.4221 6.6328 3.0925 6.2914L11.0925 2.2178C11.6627 1.9274 12.3373 1.9274 12.9075 2.2178Z"/>
                                                                </Canvas>
                                                            </Viewbox>
                                                            <Image Source="{Binding IconBitmap}" Stretch="UniformToFill"/>
                                                        </Panel>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="Bold" FontSize="13"/>
                                                        <TextBlock Text="{Binding AuthorAndDownloads}" Foreground="#A250FF" FontSize="10" Margin="0,2,0,4"/>
                                                        <TextBlock Text="{Binding Description}" Foreground="#8E9297" FontSize="11" TextWrapping="Wrap" MaxLines="2"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Content="Установить" Click="InstallModrinthProject_Click" Tag="{Binding}" Height="30" Padding="14,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#A250FF" Foreground="White" FontWeight="Bold" FontSize="10" CornerRadius="6" Cursor="Hand" BorderThickness="0" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>

                                                        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <ProgressBar x:Name="OperationProgress" Height="4" IsVisible="False" Foreground="#A250FF" Background="#262933" CornerRadius="2"/>
                                    <TextBlock x:Name="OperationStatusText" Foreground="#8E9297" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

                        <Grid x:Name="CreateModal" Background="#CC000000" IsVisible="False">
                <Border Width="420" Background="#16181F" BorderBrush="#262933" BorderThickness="1" CornerRadius="14" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="ModalTitleText" Text="СОЗДАНИЕ СБОРКИ" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,6"/>

                        <StackPanel Spacing="4">
                            <TextBlock x:Name="ModalPackNameLabel" Text="НАЗВАНИЕ СБОРКИ" Foreground="#8E9297" FontSize="10" FontWeight="Bold"/>
                            <TextBox x:Name="NewPackNameBox" Watermark="Например: Моя сборка" Height="36" Background="#1E2028" Foreground="White" BorderBrush="#2A2E39" CornerRadius="8"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock x:Name="ModalPackVersionLabel" Text="ВЕРСИЯ MINECRAFT" Foreground="#8E9297" FontSize="10" FontWeight="Bold"/>
                            <Grid ColumnDefinitions="*,130">
                                <TextBox x:Name="NewPackVersionBox" Watermark="1.20.1" Height="36" Background="#1E2028" Foreground="White" BorderBrush="#2A2E39" CornerRadius="8,0,0,8" VerticalContentAlignment="Center" Margin="0,0,1,0"/>
                                <ComboBox x:Name="NewPackVersionSelect" Grid.Column="1" Height="36" Classes="RayCombo" CornerRadius="0,8,8,0" HorizontalAlignment="Stretch" SelectionChanged="NewPackVersionSelect_SelectionChanged"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock x:Name="ModalPackLoaderLabel" Text="ЗАГРУЗЧИК (LOADER)" Foreground="#8E9297" FontSize="10" FontWeight="Bold"/>
                            <ComboBox x:Name="NewPackLoaderBox" Height="36" Classes="RayCombo" HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,*" Margin="0,10,0,0">
                            <Button x:Name="CancelCreateButton" Grid.Column="0" Content="Отмена" Click="CancelCreate_Click" Height="36" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#1E2028" Foreground="White" FontWeight="SemiBold" CornerRadius="8" Cursor="Hand" BorderThickness="0" Margin="0,0,4,0"/>
                            <Button x:Name="ConfirmCreateButton" Grid.Column="1" Content="Создать" Click="ConfirmCreate_Click" Height="36" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#A250FF" Foreground="White" FontWeight="Bold" CornerRadius="8" Cursor="Hand" BorderThickness="0" Margin="4,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Panel>
    </Border>
</Window>
