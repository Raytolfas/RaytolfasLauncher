<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RaytolfasLauncher"
        x:Class="RaytolfasLauncher.ModpacksWindow"
        Title="Управление сборками"
        Height="620"
        Width="940"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        CanResize="False"
        PointerPressed="Window_PointerPressed">

    <Border BorderBrush="#1A1A1A" BorderThickness="1" CornerRadius="20" Background="#121212" ClipToBounds="True">
        <Panel>
            <Grid RowDefinitions="Auto,*" Margin="20,16,20,18">
            <!-- Header Bar -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📦" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock x:Name="HeaderTitleText" Text="СБОРКИ И МОДЫ" Foreground="#BB86FC" FontSize="16" FontWeight="Bold"/>
                        <TextBlock x:Name="HeaderSubtitleText" Text="Создание своих сборок и загрузка модов, ресурс-паков и шейдеров с Modrinth" Foreground="Gray" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Click="Close_Click" Background="Transparent" Foreground="Gray" BorderThickness="0" Width="36" Height="36" FontSize="18" Cursor="Hand" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
            </Grid>

            <!-- Main Content: Left & Right Columns -->
            <Grid Grid.Row="1" ColumnDefinitions="290,16,*">
                <!-- Left Column: Modpacks List -->
                <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto">
                    <TextBlock x:Name="YourPacksLabel" Grid.Row="0" Text="ВАШИ СБОРКИ" Foreground="#BB86FC" FontSize="11" FontWeight="Bold" Margin="4,0,0,8"/>

                    <ListBox x:Name="ModpacksListBox" Grid.Row="1" Background="#1E1E1E" BorderThickness="0" CornerRadius="12" SelectionChanged="ModpacksListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="local:ModpackInfo">
                                <Border Padding="8,6" CornerRadius="8" Background="Transparent">
                                    <Grid ColumnDefinitions="32,*">
                                        <TextBlock Grid.Column="0" Text="📦" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" Foreground="White" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Subtitle}" Foreground="Gray" FontSize="10" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Left Column Action Buttons -->
                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <Button x:Name="CreatePackButton" Content="+ СОЗДАТЬ СБОРКУ" Click="OpenCreateModal_Click" Height="36" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#BB86FC" Foreground="Black" FontWeight="Bold" FontSize="12" CornerRadius="10" Cursor="Hand" BorderThickness="0" Margin="0,0,0,8"/>
                        <Grid ColumnDefinitions="*,*">
                            <Button x:Name="ImportMrPackButton" Grid.Column="0" Content="📥 .MRPACK" Click="ImportMrPack_Click" Height="32" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#2D2D2D" Foreground="White" FontWeight="SemiBold" FontSize="11" CornerRadius="8" Cursor="Hand" BorderThickness="0" Margin="0,0,4,0"/>
                            <Button x:Name="DeletePackButton" Grid.Column="1" Content="🗑️ УДАЛИТЬ" Click="DeleteModpack_Click" Height="32" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#2D2D2D" Foreground="#CF6679" FontWeight="SemiBold" FontSize="11" CornerRadius="8" Cursor="Hand" BorderThickness="0" Margin="4,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Right Column: Selected Modpack Details & Content -->
                <Grid Grid.Column="2">
                    <!-- Placeholder when nothing is selected -->
                    <Border x:Name="NoSelectionPanel" Background="#181818" CornerRadius="14" Padding="24" IsVisible="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="📦" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                            <TextBlock x:Name="NoSelectionTitle" Text="Выберите сборку слева или создайте новую" Foreground="White" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="NoSelectionSubtitle" Text="Каждая сборка имеет свою папку версий и каталоги mods, resourcepacks, shaderpacks" Foreground="Gray" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,16"/>
                            <Button x:Name="NoSelectionCreateButton" Content="+ Создать свою первую сборку" Click="OpenCreateModal_Click" Height="38" Padding="20,0" HorizontalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#BB86FC" Foreground="Black" FontWeight="Bold" CornerRadius="10" Cursor="Hand" BorderThickness="0"/>
                        </StackPanel>
                    </Border>

                    <!-- Selected Pack Content -->
                    <Grid x:Name="PackDetailsPanel" RowDefinitions="Auto,Auto,Auto,*,Auto" IsVisible="False">
                        <!-- Pack Header -->
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="SelectedPackTitle" Text="Моя сборка" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Border x:Name="SelectedPackBadge" Background="#2A1E35" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                    <TextBlock x:Name="SelectedPackBadgeText" Text="Fabric 1.20.1" Foreground="#BB86FC" FontSize="11" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="SelectForPlayBtn" Content="▶ ВЫБРАТЬ ДЛЯ ИГРЫ" Click="SelectForPlay_Click" Height="32" Padding="14,0" Background="#03DAC6" Foreground="Black" FontWeight="Bold" FontSize="11" CornerRadius="8" Cursor="Hand" BorderThickness="0" VerticalContentAlignment="Center"/>
                        </Grid>

                        <!-- Quick Folder Shortcuts Row -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                            <Button x:Name="OpenPackFolderBtn" Content="📁 Папка сборки" Click="OpenPackFolder_Click" Height="28" Padding="10,0" Margin="0,0,6,0" Background="#252525" Foreground="White" FontSize="11" CornerRadius="6" Cursor="Hand" BorderThickness="0"/>
                            <Button Content="🧩 mods" Click="OpenModsFolder_Click" Height="28" Padding="10,0" Margin="0,0,6,0" Background="#252525" Foreground="#BB86FC" FontSize="11" FontWeight="SemiBold" CornerRadius="6" Cursor="Hand" BorderThickness="0"/>
                            <Button Content="🎨 resourcepacks" Click="OpenResourcepacksFolder_Click" Height="28" Padding="10,0" Margin="0,0,6,0" Background="#252525" Foreground="#03DAC6" FontSize="11" FontWeight="SemiBold" CornerRadius="6" Cursor="Hand" BorderThickness="0"/>
                            <Button Content="🌅 shaderpacks" Click="OpenShaderpacksFolder_Click" Height="28" Padding="10,0" Background="#252525" Foreground="#FFB74D" FontSize="11" FontWeight="SemiBold" CornerRadius="6" Cursor="Hand" BorderThickness="0"/>
                        </StackPanel>

                        <!-- Content Tabs -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="TabInstalledBtn" Content="УСТАНОВЛЕННЫЕ ФАЙЛЫ" Click="ShowInstalledTab_Click" Height="30" Padding="12,0" Margin="0,0,6,0" Background="#BB86FC" Foreground="Black" FontWeight="Bold" FontSize="11" CornerRadius="8" Cursor="Hand" BorderThickness="0"/>
                            <Button x:Name="TabModrinthBtn" Content="КАТАЛОГ MODRINTH" Click="ShowModrinthTab_Click" Height="30" Padding="12,0" Background="#252525" Foreground="White" FontWeight="Bold" FontSize="11" CornerRadius="8" Cursor="Hand" BorderThickness="0"/>
                        </StackPanel>

                        <!-- Tab 1: Installed Files Panel -->
                        <Grid x:Name="InstalledTabPanel" Grid.Row="3" RowDefinitions="Auto,*" IsVisible="True">
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <Button x:Name="FilterAllBtn" Content="Все" Click="FilterInstalled_Click" Tag="all" Height="24" Padding="8,0" Margin="0,0,4,0" Background="#BB86FC" Foreground="Black" FontSize="10" FontWeight="Bold" CornerRadius="6" Cursor="Hand" BorderThickness="0"/>
                                <Button x:Name="FilterModsBtn" Content="Моды" Click="FilterInstalled_Click" Tag="mods" Height="24" Padding="8,0" Margin="0,0,4,0" Background="#252525" Foreground="White" FontSize="10" CornerRadius="6" Cursor="Hand" BorderThickness="0"/>
                                <Button x:Name="FilterPacksBtn" Content="Ресурс-паки" Click="FilterInstalled_Click" Tag="resourcepacks" Height="24" Padding="8,0" Margin="0,0,4,0" Background="#252525" Foreground="White" FontSize="10" CornerRadius="6" Cursor="Hand" BorderThickness="0"/>
                                <Button x:Name="FilterShadersBtn" Content="Шейдеры" Click="FilterInstalled_Click" Tag="shaderpacks" Height="24" Padding="8,0" Background="#252525" Foreground="White" FontSize="10" CornerRadius="6" Cursor="Hand" BorderThickness="0"/>
                            </StackPanel>

                            <ListBox x:Name="InstalledFilesListBox" Grid.Row="1" Background="#181818" BorderThickness="0" CornerRadius="10">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="local:ModpackFileItem">
                                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="4,2">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}" Foreground="White" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Category}" Foreground="Gray" FontSize="10"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding FileSizeFormatted}" Foreground="Gray" FontSize="11" VerticalAlignment="Center" Margin="10,0,10,0"/>
                                            <Button Grid.Column="2" Content="✕" Click="DeleteFile_Click" Tag="{Binding FullPath}" Background="Transparent" Foreground="#CF6679" BorderThickness="0" Cursor="Hand" FontSize="14" Width="26" Height="26" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <!-- Tab 2: Modrinth Catalog Panel -->
                        <Grid x:Name="ModrinthTabPanel" Grid.Row="3" RowDefinitions="Auto,*" IsVisible="False">
                            <!-- Search Form -->
                            <Grid Grid.Row="0" ColumnDefinitions="*,130,90" Margin="0,0,0,8">
                                <TextBox x:Name="ModrinthSearchBox" Grid.Column="0" Watermark="Поиск модов на Modrinth..." Height="32" Background="#252525" Foreground="White" BorderBrush="#3A3A3A" CornerRadius="8" Margin="0,0,6,0" KeyDown="ModrinthSearchBox_KeyDown"/>
                                <ComboBox x:Name="ModrinthTypeBox" Grid.Column="1" Height="32" Classes="RayCombo" HorizontalAlignment="Stretch" Margin="0,0,6,0" SelectionChanged="ModrinthTypeBox_SelectionChanged"/>
                                <Button x:Name="SearchModrinthButton" Grid.Column="2" Content="🔍 Найти" Click="SearchModrinth_Click" Height="32" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#BB86FC" Foreground="Black" FontWeight="Bold" FontSize="11" CornerRadius="8" Cursor="Hand" BorderThickness="0"/>
                            </Grid>

                            <!-- Search Results List -->
                            <ListBox x:Name="ModrinthResultsListBox" Grid.Row="1" Background="#181818" BorderThickness="0" CornerRadius="10">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="local:ModrinthProjectHit">
                                        <Border Padding="10,8" Margin="0,0,0,4" Background="#202020" CornerRadius="8">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="Bold" FontSize="13"/>
                                                    <TextBlock Text="{Binding AuthorAndDownloads}" Foreground="#BB86FC" FontSize="10" Margin="0,2,0,4"/>
                                                    <TextBlock Text="{Binding Description}" Foreground="Gray" FontSize="11" TextWrapping="Wrap" MaxLines="2"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="УСТАНОВИТЬ" Click="InstallModrinthProject_Click" Tag="{Binding}" Height="30" Padding="12,0" Background="#03DAC6" Foreground="Black" FontWeight="Bold" FontSize="10" CornerRadius="6" Cursor="Hand" BorderThickness="0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <!-- Bottom Status / Progress -->
                        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <ProgressBar x:Name="OperationProgress" Height="4" IsVisible="False" Foreground="#BB86FC" Background="#2A2A2A" CornerRadius="2"/>
                                <TextBlock x:Name="OperationStatusText" Foreground="Gray" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- Create Modpack Modal Dialog -->
        <Grid x:Name="CreateModal" Background="#CC000000" IsVisible="False">
            <Border Width="420" Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1" CornerRadius="16" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="ModalTitleText" Text="СОЗДАНИЕ СБОРКИ" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

                    <TextBlock x:Name="ModalPackNameLabel" Text="НАЗВАНИЕ СБОРКИ" Foreground="Gray" FontSize="10" Margin="0,0,0,6"/>
                    <TextBox x:Name="NewPackNameBox" Watermark="Например: Моя сборка" Height="36" Background="#2A2A2A" Foreground="White" BorderBrush="#403A35" CornerRadius="10" Margin="0,0,0,14"/>

                    <TextBlock x:Name="ModalPackVersionLabel" Text="ВЕРСИЯ MINECRAFT" Foreground="Gray" FontSize="10" Margin="0,0,0,6"/>
                    <Grid ColumnDefinitions="*,130" Margin="0,0,0,14">
                        <TextBox x:Name="NewPackVersionBox" Watermark="1.20.1" Height="36" Background="#2A2A2A" Foreground="White" BorderBrush="#403A35" CornerRadius="10,0,0,10" VerticalContentAlignment="Center" Margin="0,0,1,0"/>
                        <ComboBox x:Name="NewPackVersionSelect" Grid.Column="1" Height="36" Classes="RayCombo" CornerRadius="0,10,10,0" HorizontalAlignment="Stretch" SelectionChanged="NewPackVersionSelect_SelectionChanged"/>
                    </Grid>

                    <TextBlock x:Name="ModalPackLoaderLabel" Text="ЗАГРУЗЧИК (LOADER)" Foreground="Gray" FontSize="10" Margin="0,0,0,6"/>
                    <ComboBox x:Name="NewPackLoaderBox" Height="36" Classes="RayCombo" HorizontalAlignment="Stretch" Margin="0,0,0,22"/>

                    <Grid ColumnDefinitions="*,*">
                        <Button x:Name="CancelCreateButton" Grid.Column="0" Content="ОТМЕНА" Click="CancelCreate_Click" Height="36" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#2D2D2D" Foreground="White" FontWeight="SemiBold" CornerRadius="10" Cursor="Hand" BorderThickness="0" Margin="0,0,6,0"/>
                        <Button x:Name="ConfirmCreateButton" Grid.Column="1" Content="СОЗДАТЬ" Click="ConfirmCreate_Click" Height="36" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#BB86FC" Foreground="Black" FontWeight="Bold" CornerRadius="10" Cursor="Hand" BorderThickness="0" Margin="6,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
        </Panel>
    </Border>
</Window>
