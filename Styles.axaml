<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Context Menu Style -->
    <Style Selector="ContextMenu.RayMenu">
        <Setter Property="Background" Value="#1E1E1E"/>
        <Setter Property="BorderBrush" Value="#3A3A3A"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="6"/>
    </Style>

    <Style Selector="ContextMenu.RayMenu MenuItem">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Margin" Value="2"/>
    </Style>

    <Style Selector="ContextMenu.RayMenu MenuItem:pointerover /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="Background" Value="#333333"/>
    </Style>

    <Style Selector="ContextMenu.RayMenu Separator">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="#444444"/>
        <Setter Property="Margin" Value="10,4"/>
    </Style>

    <!-- Custom Ray CheckBox Style -->
    <Style Selector="CheckBox.RayCheck">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="CheckBox.RayCheck /template/ Border#NormalRectangle">
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Background" Value="#2D2D2D"/>
        <Setter Property="BorderBrush" Value="#3A3A3A"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
    </Style>

    <Style Selector="CheckBox.RayCheck:pointerover /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="#343434"/>
    </Style>

    <Style Selector="CheckBox.RayCheck:checked /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="#2D2D2D"/>
        <Setter Property="BorderBrush" Value="#BB86FC"/>
    </Style>

    <Style Selector="CheckBox.RayCheck:checked /template/ Path#CheckGlyph">
        <Setter Property="Fill" Value="#BB86FC"/>
    </Style>

    <!-- Custom Ray ComboBox Style -->
    <Style Selector="ComboBox.RayCombo">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="#2A2A2A"/>
        <Setter Property="BorderBrush" Value="#403A35"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="12,6"/>
    </Style>

    <Style Selector="ComboBox.RayCombo:pointerover /template/ Border#Background">
        <Setter Property="BorderBrush" Value="#6A4D86"/>
    </Style>

    <Style Selector="ComboBox.RayCombo:focus /template/ Border#Background">
        <Setter Property="BorderBrush" Value="#BB86FC"/>
    </Style>

    <Style Selector="ComboBox.RayCombo ComboBoxItem">
        <Setter Property="Foreground" Value="#BB86FC"/>
        <Setter Property="Background" Value="#1E1E1E"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Margin" Value="4,2"/>
    </Style>

    <Style Selector="ComboBox.RayCombo ComboBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#32263D"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style Selector="ComboBox.RayCombo ComboBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="#4B2A69"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- Slider Style for RAM -->
    <Style Selector="Slider">
        <Setter Property="Foreground" Value="#BB86FC"/>
    </Style>

</Styles>
